{
  "name": "pdf-creator-editor",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "postinstall": "node scripts/prepare-assets.mjs",
    "test:e2e": "playwright test",
    "build:portable": "npm run build && node scripts/build-portable.mjs",
    "test:portable": "playwright test --config playwright.portable.config.ts",
    "publish:pages": "node scripts/publish-pages.mjs --publish"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "lucide-react": "1.61.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
